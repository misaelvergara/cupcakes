{
  "name": "cupcakes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:full": "npm install && npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:backend": "jest --coverage",
    "test:backend:watch": "jest --watch",
    "server": "node bakery/server.js",
    "server:prod": "NODE_ENV=production node bakery/server.js",
    "dev:server": "nodemon bakery/server.js",
    "dev": "concurrently \"npm run start\" \"npm run dev:server\""
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/animations": "^17.3.0",
    "@angular/cli": "^17.3.8",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "sqlite3": "^5.1.7",
    "tslib": "^2.3.0",
    "typescript": "~5.4.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@types/jasmine": "~5.1.0",
    "concurrently": "^8.2.2",
    "jasmine-core": "~5.1.0",
    "jest": "^29.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "typescript": "~5.4.2"
  }
}
